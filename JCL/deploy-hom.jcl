//RAFAELTH JOB ,NOTIFY=&SYSUID,MSGCLASS=H,MSGLEVEL=(1,1),REGION=144M
//*
//* DEPLOY SIMULADO: LOAD -> LOAD.HOM E EXECUCAO DO PCFDEMO NO AMBIENTE HOM
//*
//    SET HLQ='RAFAELT'
//*
//COPYLOAD EXEC PGM=IEBCOPY
//SYSPRINT DD SYSOUT=*
//INLOAD   DD DISP=SHR,DSN=&HLQ..SAMPLE.LOAD
//OUTLOAD  DD DISP=SHR,DSN=&HLQ..SAMPLE.LOAD.HOM
//SYSIN    DD *
  COPY INDD=((INLOAD,R)),OUTDD=OUTLOAD
    SELECT MEMBER=(PCFDEMO)
/*
//*
//*
//*********************************************************************
//* EXECUCAO DO PROGRAMA PCF NO AMBIENTE HOMOLOGACAO
//*********************************************************************
//IFCOPY   IF (COPYLOAD.RC <= 4) THEN
//RUNHOM   EXEC PGM=PCFDEMO
//STEPLIB  DD DISP=SHR,DSN=&HLQ..SAMPLE.LOAD.HOM
//SYSOUT   DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
//CEEDUMP  DD SYSOUT=*
//SYSUDUMP DD SYSOUT=*
//IFCOPY   ENDIF